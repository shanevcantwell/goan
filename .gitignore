# =============================================================================
# General / OS / IDE
# =============================================================================
# Operating System generated files
.DS_Store
Thumbs.db

# IDE and editor configuration files
.idea/
.vscode/
*.swp
*.swo

# =============================================================================
# Python / Server Workspace
# =============================================================================
# Virtual Environment
# Never commit the virtual environment itself.
.venv/
venv/
ENV/
env/

# Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================================================================
# Node.js / Client Workspace
# =============================================================================
# Dependencies
# This is the most important rule for any Node.js project.
node_modules/

# Next.js build artifacts and cache
.next/
out/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment variables
# Contains secrets and machine-specific settings.
.env.local
.env.*.local

# =============================================================================
# Testing (Optional but Recommended)
# =============================================================================
.pytest_cache/
.coverage
htmlcov/
loras/
.env
goan-development.code-workspace
