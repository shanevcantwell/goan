#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/shane/github/shanevcantwell/goan-development/node_modules/nypm/dist/node_modules:/home/shane/github/shanevcantwell/goan-development/node_modules/nypm/node_modules:/home/shane/github/shanevcantwell/goan-development/node_modules:/home/shane/github/shanevcantwell/node_modules:/home/shane/github/node_modules:/home/shane/node_modules:/home/node_modules:/node_modules:/home/shane/github/shanevcantwell/goan-development/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/shane/github/shanevcantwell/goan-development/node_modules/nypm/dist/node_modules:/home/shane/github/shanevcantwell/goan-development/node_modules/nypm/node_modules:/home/shane/github/shanevcantwell/goan-development/node_modules:/home/shane/github/shanevcantwell/node_modules:/home/shane/github/node_modules:/home/shane/node_modules:/home/node_modules:/node_modules:/home/shane/github/shanevcantwell/goan-development/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../nypm/dist/cli.mjs" "$@"
else
  exec node  "$basedir/../nypm/dist/cli.mjs" "$@"
fi
