# Default text files to auto-detect line endings on checkout,
# but normalize to LF in the repository.
* text=auto

# Ensure shell scripts always have LF line endings and are executable
*.sh text eol=lf
*.sh filter=lfs diff=lfs merge=lfs # If you're using Git LFS for large files, otherwise remove

# Ensure Windows batch files always have CRLF line endings
*.bat text eol=crlf

# Treat common binary files as binary (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.zip binary
*.exe binary
*.dll binary

